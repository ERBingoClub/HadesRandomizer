<Window x:Class="Athena.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Athena"
        xmlns:views="clr-namespace:Athena.Views"
        xmlns:viewModels="clr-namespace:Athena.ViewModels"
        Title="Athena Randomizer v0.22" Height="420" Width="800"
        ResizeMode="CanMinimize"
        WindowStyle="SingleBorderWindow"
        >
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:TabViewModelBase}">
            <views:TabControlBase />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TabViewModelBaseDlc}">
            <views:TabControlBaseDlc />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TabViewModelDlc}">
            <views:TabControlDlc />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="9*"/>
        </Grid.ColumnDefinitions>
        <DockPanel Grid.ColumnSpan="2">
            <TabControl ItemsSource="{Binding ModeTabs}"
                        SelectedItem="{Binding SelectedTab}"
                        DockPanel.Dock="Top"
                        >
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem">
                        <Setter Property="Width" Value="260" />
                        <Setter Property="FontWeight" Value="Normal" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <ContentPresenter Content="{Binding}" />
                    </DataTemplate>
                </TabControl.ContentTemplate>

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Title}" />
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>
        </DockPanel>

        <Button Content="About"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Right"
            Margin="0,0,16,16"
            Height="30"
            Width="60"
            Padding="4"
            Click="AboutButton_Click" Grid.Column="1" />
    </Grid>
</Window>
